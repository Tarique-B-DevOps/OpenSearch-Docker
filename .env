# Multi Node Cluster
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Str0ng!Passw0rd@2025
OPENSEARCH_CLUSTER_NAME=opensearch-cluster
OPENSEARCH_NODE1_NAME=opensearch-node1
OPENSEARCH_NODE2_NAME=opensearch-node2
OPENSEARCH_DISCOVERY_SEED_HOSTS=opensearch-node1,opensearch-node2
OPENSEARCH_INITIAL_CLUSTER_MANAGER_NODES=opensearch-node1,opensearch-node2
OPENSEARCH_BOOTSTRAP_MEMORY_LOCK=true
OPENSEARCH_JAVA_OPTS=-Xms4g -Xmx4g  # allocate 50% of available memory
OPENSEARCH_HOSTS=["https://opensearch-node1:9200","https://opensearch-node2:9200"]
OPENSEARCH_PER_NODE_CPU_LIMIT='4' # recommended for production, adjust based on your system
OPENSEARCH_PER_NODE_MEM_LIMIT=8g # recommended for production, adjust based on your system
OPENSEARCH_PER_NODE_CPU_RESERVATION='2'
OPENSEARCH_PER_NODE_MEM_RESERVATION=4g
OPENSEARCH_DASHBOARD_CPU_LIMIT='2'
OPENSEARCH_DASHBOARD_MEM_LIMIT=2g
OPENSEARCH_DASHBOARD_CPU_RESERVATION='1'
OPENSEARCH_DASHBOARD_MEM_RESERVATION=1g