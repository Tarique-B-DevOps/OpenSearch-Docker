# Single Node Cluster (Dev)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Str0ng!Passw0rd@2025
OPENSEARCH_DEV_JAVA_OPTS=-Xms2g -Xmx2g # allocate 50% of available memory
OPENSEARCH_DEV_CLUSTER_NAME=opensearch-dev-cluster
OPENSEARCH_DEV_HOSTS=["https://opensearch-dev:9200"]
OPENSEARCH_DEV_CPU_LIMIT='4'    # change base on your system, but keep it at least 1 for development
OPENSEARCH_DEV_MEM_LIMIT=4g # change base on your system, but keep it at least 2g for development
OPENSEARCH_DEV_CPU_RESERVATION='2'
OPENSEARCH_DEV_MEM_RESERVATION=2g
OPENSEARCH_DASHBOARD_CPU_LIMIT='1'
OPENSEARCH_DASHBOARD_MEM_LIMIT=1g
OPENSEARCH_DASHBOARD_CPU_RESERVATION='0.5'
OPENSEARCH_DASHBOARD_MEM_RESERVATION=512m
